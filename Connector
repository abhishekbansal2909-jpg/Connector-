import pandas as pd
from transformers import pipeline

# 1. LOAD THE BULK DATA
# Simulating a large dataset of German product reviews
data = {
    'Review': [
        "Die Qualität ist hervorragend und der Versand war sehr schnell.",
        "Leider ging das Gerät nach zwei Tagen kaputt. Keine Empfehlung.",
        "Das Produkt macht, was es soll, ist aber etwas zu teuer.",
        "Ein absolutes Meisterwerk! Ich bin begeistert.",
        "Schlechter Kundenservice, niemand antwortet auf meine E-Mails."
    ]
}
df = pd.DataFrame(data)

# 2. INITIALIZE THE NLP PIPELINE
print("Loading the German sentiment model...")
nlp_classifier = pipeline("sentiment-analysis", model="oliverguhr/german-sentiment-bert")

# 3. PROCESS THE DATAFRAME IN BULK
print("Analyzing sentiment across all reviews...")
# Apply the model to each text in the 'Review' column
df['Raw_Result'] = df['Review'].apply(lambda text: nlp_classifier(text)[0])

# Extract the label and percentage score into their own clean columns
df['Sentiment'] = df['Raw_Result'].apply(lambda res: res['label'].upper())
df['Confidence (%)'] = df['Raw_Result'].apply(lambda res: round(res['score'] * 100, 2))

# Drop the raw dictionary column for a clean final table
df = df.drop(columns=['Raw_Result'])

print("\n--- Bulk Sentiment Analysis Complete ---\n")
print(df.to_string(index=False))
