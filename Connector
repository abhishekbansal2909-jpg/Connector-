import pandas as pd

# 1. Bypass the firewall by having Google's servers pull the CSV directly from a GitHub mirror
url = 'https://raw.githubusercontent.com/genieincodebottle/aiml-companion/main/projects/ipl-match-predictor/data/raw/matches.csv'
df = pd.read_csv(url)

# 2. Let's verify the data loaded successfully
print("Data loaded successfully!")
print(f"Total historical matches downloaded: {df.shape[0]}")

# 3. Filter the dataset to ONLY include matches where RCB was playing
rcb_matches = df[(df['team1'] == 'Royal Challengers Bangalore') | (df['team2'] == 'Royal Challengers Bangalore')]

print(f"Total RCB matches found: {rcb_matches.shape[0]}")

# 4. Preview the first 5 rows to see what raw data looks like before we engineer it
rcb_matches.head()
