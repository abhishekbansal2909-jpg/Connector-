import pandas as pd
import numpy as np
from sklearn.model_selection import train_test_split
from sklearn.ensemble import RandomForestClassifier
from sklearn.metrics import accuracy_score, classification_report

# 1. LOAD THE DATA
url = 'https://raw.githubusercontent.com/genieincodebottle/aiml-companion/main/projects/ipl-match-predictor/data/raw/matches.csv'
df = pd.read_csv(url)

rcb_matches = df[(df['team1'] == 'Royal Challengers Bangalore') | (df['team2'] == 'Royal Challengers Bangalore')].copy()

# 2. DATA CLEANING & FEATURE ENGINEERING
rcb_matches = rcb_matches.dropna(subset=['winner'])
rcb_matches['rcb_win'] = (rcb_matches['winner'] == 'Royal Challengers Bangalore').astype(int)

rcb_matches['opponent'] = np.where(rcb_matches['team1'] == 'Royal Challengers Bangalore', 
                                   rcb_matches['team2'], 
                                   rcb_matches['team1'])
rcb_matches['rcb_won_toss'] = (rcb_matches['toss_winner'] == 'Royal Challengers Bangalore').astype(int)

# Recent Form 
rcb_matches['date'] = pd.to_datetime(rcb_matches['date'])
rcb_matches = rcb_matches.sort_values('date')
rcb_matches['recent_form'] = rcb_matches['rcb_win'].shift(1).rolling(window=3).sum().fillna(0)

# --- THE NEW ENHANCEMENT: HOME ADVANTAGE ---
# Check if the city is Bangalore/Bengaluru. If yes, 1. If no, 0.
rcb_matches['is_home_match'] = rcb_matches['city'].isin(['Bangalore', 'Bengaluru']).astype(int)
# -------------------------------------------

# Update our features list to include the new 'is_home_match' column
features = ['opponent', 'rcb_won_toss', 'toss_decision', 'city', 'recent_form', 'is_home_match']
X = rcb_matches[features].copy().dropna()
y = rcb_matches.loc[X.index, 'rcb_win']

# 3. TRANSLATE TEXT TO MATH
X_encoded = pd.get_dummies(X, columns=['opponent', 'toss_decision', 'city'])

# 4. TRAIN THE RANDOM FOREST
X_train, X_test, y_train, y_test = train_test_split(X_encoded, y, test_size=0.2, random_state=42)

model = RandomForestClassifier(n_estimators=100, random_state=42, max_depth=5)
model.fit(X_train, y_train)

# 5. EVALUATE
predictions = model.predict(X_test)

print("--- RCB Predictor: Home Advantage Added ---")
print(f"Accuracy Score: {accuracy_score(y_test, predictions) * 100:.2f}%\n")
print("Detailed Report:")
print(classification_report(y_test, predictions))
