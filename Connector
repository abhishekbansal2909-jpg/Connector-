import os
from fastapi import FastAPI, Request
from fastapi.responses import Response
from typing import TypedDict
from langgraph.graph import StateGraph, END
from langchain_groq import ChatGroq
from langchain_core.messages import HumanMessage

# --- 1. FastAPI Setup ---
# Initialize the FastAPI application
app = FastAPI(title="Simplified Voice PM Orchestrator")

# --- 2. LangGraph State & Agent Setup ---
# Define the state schema using TypedDict
class PMState(TypedDict):
    messages: list
    intent: str
    project_data: dict
    final_audio_text: str

# Initialize the Groq LLM
llm = ChatGroq(model_name="llama-3.3-70b-versatile")

def analyze_intent(state: PMState):
    """Determines the user's intent based on their spoken input."""
    last_message = state["messages"][-1].content
    prompt = f"""
    Analyze this message: "{last_message}"
    Classify the intent as exactly one of these:
    - STATUS_CHECK: Asking for timeline, progress, or risks.
    - SCOPE_CHANGE: Asking to add a feature or change the baseline.
    - GENERAL: General conversation.
    Reply with ONLY the classification string.
    """
    response = llm.invoke([HumanMessage(content=prompt)])
    return {"intent": response.content.strip()}

def fetch_status(state: PMState):
    """Simulates checking a project management database."""
    mock_cloud_db = {
        "project": "Voice Agent PM Build",
        "phase": "API Integration",
        "risk_status": "High - 2 days behind schedule."
    }
    return {"project_data": mock_cloud_db}

def handle_scope_creep(state: PMState):
    """Handles requests that fall outside the project scope."""
    return {"final_audio_text": "I have logged that feature request. However, it requires a formal PMP review."}

def synthesize_report(state: PMState):
    """Generates the spoken response based on the project data."""
    data = state["project_data"]
    prompt = f"Turn this data into a professional 1-sentence spoken update: {data}"
    response = llm.invoke([HumanMessage(content=prompt)])
    return {"final_audio_text": response.content}

def route_intent(state: PMState):
    """Routes the logic based on the analyzed intent."""
    if state["intent"] == "STATUS_CHECK":
        return "fetch_status"
    elif state["intent"] == "SCOPE_CHANGE":
        return "handle_scope_creep"
    return END

# --- 3. Compile the Graph ---
# Create an instance of StateGraph with the structure of PMState
workflow = StateGraph(PMState)

# Register the nodes in the graph
workflow.add_node("analyze_intent", analyze_intent)
workflow.add_node("fetch_status", fetch_status)
workflow.add_node("handle_scope_creep", handle_scope_creep)
workflow.add_node("synthesize_report", synthesize_report)

# Set the entry point
workflow.set_entry_point("analyze_intent")

# Add conditional edges
workflow.add_conditional_edges(
    "analyze_intent", route_intent,
    {"fetch_status": "fetch_status", "handle_scope_creep": "handle_scope_creep", END: END}
)

# Add normal edges
workflow.add_edge("fetch_status", "synthesize_report")
workflow.add_edge("synthesize_report", END)
workflow.add_edge("handle_scope_creep", END)

# Compile the workflow into an executable graph
pm_orchestrator = workflow.compile()

# --- 4. The Twilio Endpoint ---
# Define a path operation decorator for POST requests
@app.post("/voice-intent")
async def handle_voice_intent(request: Request):
    """Handles the incoming form data from Twilio and returns TwiML."""
    try:
        # Twilio sends data as form-urlencoded
        form_data = await request.form()
        
        # 'SpeechResult' contains the transcribed result of the caller's speech
        user_input = form_data.get("SpeechResult")
        
        # Start building the TwiML XML response
        # To collect input during a call, use the <Gather> verb in the TwiML language
        twiml_response = '<?xml version="1.0" encoding="UTF-8"?>\n<Response>\n'
        
        if user_input:
            # Run the incoming voice text through the LangGraph machine
            # We call invoke() on the compiled graph
            result = pm_orchestrator.invoke({"messages": [HumanMessage(content=user_input)]})
            response_text = result.get('final_audio_text', 'I am not sure how to help with that.')
            twiml_response += f'<Say>{response_text}</Say>\n'
        else:
            twiml_response += '<Say>Project management orchestrator online. What is your request?</Say>\n'
        
        # Tell Twilio to listen for the user's next spoken command
        # When this attribute value includes speech, Twilio gathers speech from the caller
        twiml_response += '<Gather input="speech" action="/voice-intent" timeout="3" speechTimeout="auto"/>\n'
        twiml_response += '</Response>'
        
        # Return the XML with the correct content type
        return Response(content=twiml_response, media_type="application/xml")
        
    except Exception as e:
        error_twiml = f"""<?xml version="1.0" encoding="UTF-8"?>
        <Response><Say>System error: {str(e)}</Say></Response>"""
        return Response(content=error_twiml, media_type="application/xml")
