import yfinance as yf
import pandas as pd
import matplotlib.pyplot as plt

# 1. PULL THE HISTORICAL DATA
ticker_symbol = 'RICOAUTO.NS'
print(f"Downloading data for {ticker_symbol}...")

# Fetch the last 5 years of daily stock data
rico_data = yf.download(ticker_symbol, period='5y', interval='1d')

# 2. CLEAN AND PREPARE THE DATA
# Reset the index so 'Date' becomes a standard column
rico_data.reset_index(inplace=True)

# Use 'Close' instead of 'Adj Close' because yfinance now auto-adjusts by default
df = rico_data[['Date', 'Close']].copy()
df.columns = ['Date', 'Price'] # Rename for simplicity

# Remove any empty rows where trading might have been halted
df.dropna(inplace=True)

print("\n--- First 5 Rows of Rico Auto Data ---")
print(df.head())

# 3. EXPLORATORY DATA ANALYSIS (EDA) - VISUALIZATION
# Calculate a 50-day moving average to smooth out the daily noise and see the true trend
df['50_Day_MA'] = df['Price'].rolling(window=50).mean()

# Plot the actual price vs the moving average
plt.figure(figsize=(14, 7))
plt.plot(df['Date'], df['Price'], label='Actual Adjusted Close Price', color='blue', alpha=0.6)
plt.plot(df['Date'], df['50_Day_MA'], label='50-Day Moving Average', color='red', linewidth=2)

plt.title('Rico Auto (RICOAUTO.NS) - 5 Year Historical Price', fontsize=16)
plt.xlabel('Date', fontsize=12)
plt.ylabel('Stock Price (INR)', fontsize=12)
plt.legend()
plt.grid(True, linestyle='--', alpha=0.7)
plt.show()
