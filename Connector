# 4. The Twilio Endpoint
@app.post("/voice-intent")
async def handle_voice_intent(request: Request):
    try:
        # Twilio sends data as form-urlencoded, not JSON
        form_data = await request.form()
        
        # 'SpeechResult' is the text Twilio recognized from the caller
        user_input = form_data.get("SpeechResult")
        
        # Start building the TwiML XML response
        twiml_response = '<?xml version="1.0" encoding="UTF-8"?>\n<Response>\n'
        
        if user_input:
            # If the user spoke, route the text through the LangGraph machine
            result = pm_orchestrator.invoke({"messages": [HumanMessage(content=user_input)]})
            response_text = result.get('final_audio_text', 'I am not sure how to help with that.')
            
            # Add the AI's response to the TwiML
            twiml_response += f'<Say>{response_text}</Say>\n'
        else:
            # If this is the start of the call, greet the user
            twiml_response += '<Say>Project management orchestrator online. What is your request?</Say>\n'
        
        # Tell Twilio to listen for the user's next spoken command
        twiml_response += '<Gather input="speech" action="/voice-intent" timeout="3" speechTimeout="auto"/>\n'
        twiml_response += '</Response>'
        
        return Response(content=twiml_response, media_type="application/xml")
        
    except Exception as e:
        # Return a safe error message over the phone if something crashes
        error_twiml = f"""<?xml version="1.0" encoding="UTF-8"?>
        <Response><Say>System error: {str(e)}</Say></Response>"""
        return Response(content=error_twiml, media_type="application/xml")
