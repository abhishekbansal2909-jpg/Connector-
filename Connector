from transformers import pipeline

print("Downloading and loading the German NLP model... (This might take a minute)")

# 1. INITIALIZE THE PIPELINE
# We are pulling a specific BERT model trained exclusively on German text
nlp_classifier = pipeline("sentiment-analysis", model="oliverguhr/german-sentiment-bert")

# 2. CREATE OUR TEST DATA
# Let's feed the algorithm a mix of distinct sentiments
german_reviews = [
    "Das Produkt ist absolut fantastisch und funktioniert einwandfrei!", # Clear Positive
    "Ich bin sehr enttäuscht, die Lieferung war extrem spät und der Kundenservice unfreundlich.", # Clear Negative
    "Es ist in Ordnung, erfüllt seinen Zweck, aber nichts Besonderes." # Neutral/Mixed
]

print("\n--- NLP Sentiment Analysis Results ---\n")

# 3. RUN THE PREDICTIONS
predictions = nlp_classifier(german_reviews)

# 4. DISPLAY THE OUTPUT
for review, prediction in zip(german_reviews, predictions):
    # Format the score to a readable percentage
    confidence_score = prediction['score'] * 100
    sentiment_label = prediction['label']
    
    print(f"Text: '{review}'")
    print(f"Detected Sentiment: {sentiment_label.upper()}")
    print(f"Algorithm Confidence: {confidence_score:.2f}%\n")
