import yfinance as yf
import pandas as pd
from prophet import Prophet
from prophet.plot import plot_plotly

# 1. DOWNLOAD THE COMPLETE HISTORICAL DATA
ticker_symbol = 'RICOAUTO.NS'
rico_data = yf.download(ticker_symbol, period='5y', interval='1d')
rico_data.reset_index(inplace=True)

df = rico_data[['Date', 'Close']].copy()
df.columns = ['ds', 'y'] 
df['ds'] = pd.to_datetime(df['ds']).dt.tz_localize(None)
df.dropna(inplace=True)

# 2. TRAIN PROPHET ON THE FULL DATASET (No split)
full_model = Prophet(daily_seasonality=False, yearly_seasonality=True)
full_model.fit(df)

# 3. PROJECT 90 DAYS INTO THE ACTUAL FUTURE
# This extends the timeline past the current date into late 2026
future_dates = full_model.make_future_dataframe(periods=90)
forecast_future = full_model.predict(future_dates)

# 4. RENDER INTERACTIVE PLOTLY CHART
fig = plot_plotly(full_model, forecast_future)

fig.update_layout(
    title=dict(
        text='Rico Auto (RICOAUTO.NS) - 90-Day Future Forecast',
        x=0.5,
        font=dict(size=18)
    ),
    xaxis_title='Date',
    yaxis_title='Stock Price (INR)',
    hovermode='x unified',
    template='plotly_white'
)

fig.show()
