import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
from statsmodels.tsa.arima.model import ARIMA
from prophet import Prophet

# ==========================================================
# 1. ARIMA FORECASTING
# ==========================================================
arima_data = df.copy()
arima_data['Date'] = pd.to_datetime(arima_data['Date'])
arima_data.set_index('Date', inplace=True)

# Order parameters (p=5, d=1, q=0)
# p: uses last 5 days of lags | d: 1st order differencing | q: 0 moving average lags
arima_model = ARIMA(arima_data['Price'], order=(5, 1, 0))
arima_fit = arima_model.fit()

# Forecast 30 business days ahead
arima_forecast_vals = arima_fit.forecast(steps=30)
last_date = arima_data.index[-1]
future_arima_dates = pd.date_range(start=last_date + pd.Timedelta(days=1), periods=30, freq='B')

# ==========================================================
# 2. PROPHET FORECASTING
# ==========================================================
# Prophet requires strict column names: 'ds' for dates, 'y' for values
prophet_data = df[['Date', 'Price']].rename(columns={'Date': 'ds', 'Price': 'y'})
prophet_data['ds'] = pd.to_datetime(prophet_data['ds']).dt.tz_localize(None)

# Initialize Prophet model with yearly seasonality enabled
prophet_model = Prophet(daily_seasonality=False, yearly_seasonality=True)
prophet_model.fit(prophet_data)

# Create future dates dataframe for 30 calendar days ahead
future_dates = prophet_model.make_future_dataframe(periods=30)
prophet_forecast = prophet_model.predict(future_dates)

# ==========================================================
# 3. VISUALIZATION & SIDE-BY-SIDE COMPARISON
# ==========================================================
plt.figure(figsize=(14, 7))

# Plot last 150 trading days for clear historical context
recent_df = df.tail(150)
plt.plot(pd.to_datetime(recent_df['Date']), recent_df['Price'], label='Actual Historical Price', color='black', lw=2)

# Plot ARIMA 30-Day Projection
plt.plot(future_arima_dates, arima_forecast_vals, label='ARIMA 30-Day Forecast', color='orange', linestyle='--', lw=2.5)

# Plot Prophet 30-Day Projection
prophet_future = prophet_forecast.tail(30)
plt.plot(prophet_future['ds'], prophet_future['yhat'], label='Prophet 30-Day Forecast', color='green', linestyle='--', lw=2.5)

plt.title('Rico Auto (RICOAUTO.NS) - ARIMA vs Prophet 30-Day Forecast', fontsize=16)
plt.xlabel('Date', fontsize=12)
plt.ylabel('Stock Price (INR)', fontsize=12)
plt.legend()
plt.grid(True, linestyle='--', alpha=0.7)
plt.show()
